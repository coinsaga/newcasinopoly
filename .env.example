# Build-time public site identity. Use the final HTTPS origin before launch.
NEXT_PUBLIC_SITE_NAME="Casinopoly"
NEXT_PUBLIC_SITE_URL="https://casinopoly.io"

# Keep false for previews and until the site is ready for search engines.
SITE_INDEXABLE=false

# Optional Google Search Console HTML verification token (not a tracking ID).
GOOGLE_SITE_VERIFICATION=
